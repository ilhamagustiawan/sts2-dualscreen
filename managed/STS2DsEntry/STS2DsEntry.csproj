<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The custom engine opens STS2Mobile.dll and calls STS2Mobile.ModEntry in it
    before the game starts. This assembly is staged under that FILE name
    (Makefile), but its assembly NAME is STS2DsEntry: the compat pack is also
    called STS2Mobile, and Harmony's generated wrappers find it by that name.
    Only one assembly may answer to it, and it has to be the compat pack.
  -->
  <PropertyGroup>
    <AssemblyName>STS2DsEntry</AssemblyName>
    <RootNamespace>STS2Mobile</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../STS2DualScreen/STS2DualScreen.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
