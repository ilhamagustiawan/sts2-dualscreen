<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher's backdrop for window backgrounds and the boot cover, before
  Backdrop.kt sets its cropped copy: the bundled bg_start art.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/sky_top" />
    <item>
        <bitmap
            android:gravity="fill"
            android:src="@drawable/bg_start" />
    </item>
</layer-list>
