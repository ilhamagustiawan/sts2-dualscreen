<?xml version="1.0" encoding="utf-8"?>
<!-- Main-menu items: warm white at rest, gold when selected, as in the game's menu. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/menu_disabled" android:state_enabled="false" />
    <item android:color="@color/menu_selected" android:state_focused="true" />
    <item android:color="@color/menu_selected" android:state_pressed="true" />
    <item android:color="@color/menu_text" />
</selector>
