<?xml version="1.0" encoding="utf-8"?>
<!-- The primary item is always the selected-looking one, so it is gold unless disabled. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/menu_disabled" android:state_enabled="false" />
    <item android:color="@color/menu_selected" />
</selector>
