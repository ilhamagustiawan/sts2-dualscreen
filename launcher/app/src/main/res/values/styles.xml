<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LauncherTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/bg_spire</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!--
      The game activity. Godot draws everything once it is up; until then the
      launcher's backdrop shows (here, then GodotApp's boot cover).
    -->
    <style name="GodotAppMainTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowSwipeToDismiss">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@drawable/bg_spire</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="GodotAppSplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sky_top</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/GodotAppMainTheme</item>
    </style>

    <!--
      The launcher's menu, set like the game's main menu: bare serif text with
      a dark drop shadow, gold and flanked by curls when selected. The
      primary item (Play, or whatever comes next) is larger and always gold.
    -->
    <style name="LauncherMenuItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:background">@drawable/bg_menu_item</item>
        <item name="android:stateListAnimator">@null</item>
        <!-- Gold text and the curls are the focus mark; not the platform's grey box. -->
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/menu_item_text</item>
        <item name="android:shadowColor">#E6000000</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">3</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableStart">@drawable/ornament_left_focus</item>
        <item name="android:drawableEnd">@drawable/ornament_right_focus</item>
    </style>

    <style name="LauncherMenuItem.Primary">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/menu_item_text_primary</item>
    </style>

    <!-- The Steam Cloud row in the card: smaller, no curls, sharing the width. -->
    <style name="LauncherMenuItem.Small">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">15sp</item>
        <item name="android:drawableStart">@null</item>
        <item name="android:drawableEnd">@null</item>
        <item name="android:foreground">@drawable/focus_on_dark</item>
    </style>

    <style name="SettingsSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="SettingsSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SettingsNote">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- A label on the left, a dropdown of choices on the right. -->
    <style name="SettingsChoiceRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="SettingsChoiceLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SettingsChoice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">160dp</item>
        <item name="android:spinnerMode">dropdown</item>
        <item name="android:popupBackground">@color/surface_panel</item>
        <item name="android:backgroundTint">@color/gold</item>
        <item name="android:foreground">@drawable/focus_on_dark</item>
    </style>

    <style name="SettingsButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/surface_control</item>
        <item name="android:foreground">@drawable/focus_on_light</item>
        <item name="android:textColor">@color/text_on_control</item>
    </style>
</resources>
