    <string name="settings_title">Settings</string>
    <string name="settings_section_dual_screen">Lower screen</string>
    <string name="settings_dual_screen">Map and piles on the lower screen</string>
    <string name="settings_dual_screen_subtitle">With touch. Does nothing on a device with one screen.</string>
    <string name="settings_dual_screen_60">Smoother lower screen (60 FPS)</string>
    <string name="settings_dual_screen_60_subtitle">Off: 30 FPS, which saves battery and is plenty for the map and piles.</string>
    <string name="settings_default_tab">Opens on</string>
    <string name="settings_default_tab_subtitle">After that, tabs change only when you touch them.</string>
    <string name="settings_perf_note">The defaults are tuned for smooth play. Changes apply from the next launch.</string>
    <string name="settings_perf_note_missing">Start the game once: these settings live in its settings file, which it creates on first run.</string>
    <string name="settings_particles">Particle effects</string>
    <string name="settings_particles_full">Full</string>
    <string name="settings_particles_half">Reduced (half)</string>
    <string name="settings_particles_low">Low (a quarter)</string>
    <string name="settings_particles_subtitle">Sparks, embers and dust are drawn with fewer particles. Lighter on the GPU in busy fights; the effects stay recognisable.</string>
    <string name="settings_warmups">Pre-warm combat effects</string>
    <string name="settings_warmups_subtitle">As each room loads, plays its hit effects and visual effects once out of sight, so the first attack of a fight does not stutter. Uses more memory and a little load time.</string>
    <string name="settings_preload">Preload game assets</string>
    <string name="settings_preload_subtitle">Loads common assets after the main menu and keeps them loaded between rooms, instead of loading mid-fight.</string>
    <string name="settings_shader_compat">Cheaper effect shaders</string>
    <string name="settings_shader_compat_subtitle">Simpler versions of the blur, fire and slash effects, made for phone GPUs. Slightly plainer effects, less GPU time.</string>
    <string name="settings_render_size">Render resolution</string>
    <string name="settings_render_size_native">Native</string>
    <string name="settings_render_size_subtitle">Lower renders fewer pixels and scales up to the screen: softer, lighter on the GPU.</string>
    <string name="settings_msaa">Anti-aliasing</string>
    <string name="settings_msaa_off">Off</string>
    <string name="settings_msaa_subtitle">Smooths edges at a GPU cost; Off is recommended.</string>
    <string name="settings_vsync">VSync</string>
    <string name="settings_vsync_subtitle">On is recommended: with the screen at 60 Hz it keeps frames evenly paced.</string>
    <string name="settings_refresh_rate">Top screen refresh rate</string>
    <string name="settings_refresh_system">System</string>
    <string name="settings_refresh_60">60 Hz</string>
    <string name="settings_refresh_high">Highest</string>
    <string name="settings_refresh_rate_subtitle">60 Hz matches the game\'s 60 FPS limit for even frame pacing; Highest only helps with a higher limit.</string>
    <string name="settings_opengl">Use OpenGL instead of Vulkan</string>
    <string name="settings_opengl_subtitle">For comparison on devices where Vulkan misbehaves. The lower screen is cheaper to mirror on Vulkan.</string>
    <string name="settings_overlay">Performance overlay</string>
    <string name="settings_overlay_subtitle">Shows FPS and frame times over the game.</string>
    <string name="settings_section_cloud">Steam Cloud</string>
    <string name="settings_section_game">Game</string>
    <string name="settings_reset">Reset and re-prepare</string>
    <string name="settings_reset_subtitle">Re-stages the game from the downloaded files and clears its texture cache; the next launch takes longer while it rebuilds. Saves, the download and your Steam sign-in are kept.</string>
    <string name="settings_reset_done">Reset. The game is prepared again on next launch.</string>
    <string name="settings_section_graphics">Graphics</string>
    <string name="settings_cloud_sync">Sync saves with Steam Cloud</string>
    <string name="settings_cloud_sync_subtitle">Downloads newer saves right before the game starts and uploads yours when you come back. Skipped when offline.</string>
    <string name="settings_game_branch">Game version</string>
    <string name="settings_game_branch_subtitle">Beta is the game\'s public-beta branch on Steam, with the newest patch. Switching downloads only the files that differ. Finish your run first: a run started on one version may not continue on the other.</string>
