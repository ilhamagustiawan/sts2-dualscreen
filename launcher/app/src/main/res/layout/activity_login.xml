<?xml version="1.0" encoding="utf-8"?>
<!--
  Sign-in screen. Sized for the Ayn Thor's effective landscape area, which is
  only ~420dp tall, so everything here is tight on purpose.

  Two columns, and both are a way in: the QR on the left for anyone with the
  Steam mobile app, the form on the right for everyone else. They are shown
  together rather than behind a toggle because an account guarded by an emailed
  code cannot use the QR at all, and discovering that by scanning and waiting
  is a poor way to find out.

  Dressed like the launcher: the backdrop, both columns on cards, serif gold
  title and menu-style buttons.

  The Steam Guard row starts gone and is revealed only when Steam asks, since
  most of the time it never does.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="20dp"
    android:background="@drawable/bg_spire"
    android:gravity="center_vertical">

    <!-- Left: QR code. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:background="@color/text_primary">

            <ImageView
                android:id="@+id/img_qr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/login_subtitle" />

            <ProgressBar
                android:id="@+id/login_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/gold" />
        </FrameLayout>

        <TextView
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/login_subtitle"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Right: the form. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="20dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:shadowColor="@color/title_shadow"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:text="@string/login_title"
            android:textColor="@color/title_gold"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/login_password_hint"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edit_username"
            style="@style/LoginField"
            android:hint="@string/login_username"
            android:autofillHints="username"
            android:inputType="text"
            android:imeOptions="actionNext"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edit_password"
            style="@style/LoginField"
            android:hint="@string/login_password"
            android:autofillHints="password"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:layout_marginBottom="8dp" />

        <!-- Steam Guard. Revealed only when Steam asks for a code. -->
        <LinearLayout
            android:id="@+id/row_guard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/edit_guard"
                style="@style/LoginField"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="@string/login_guard_hint"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:imeOptions="actionDone" />

            <Button
                android:id="@+id/btn_guard"
                style="@style/LauncherMenuItem.Small"
                android:layout_width="wrap_content"
                android:layout_weight="0"
                android:layout_marginStart="8dp"
                android:text="@string/login_guard_submit" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_sign_in"
                style="@style/LauncherMenuItem.Action"
                android:text="@string/login_sign_in" />

            <Button
                android:id="@+id/btn_cancel"
                style="@style/LauncherMenuItem"
                android:layout_marginStart="8dp"
                android:text="@string/login_cancel" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/login_status_connecting"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
