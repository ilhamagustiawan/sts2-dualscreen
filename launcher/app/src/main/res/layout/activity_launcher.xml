<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher, dressed like the game's main menu (see bg_spire and the
  LauncherMenuItem styles). Left: the title and a centred menu whose first
  item follows the state (sign in, download, play).
  Right: a card with the three steps of a fresh install and where each one
  stands, the Steam Cloud status, and a one-line tail of the log.

  Sized for the Ayn Thor's ~420dp-tall landscape area, like the sign-in screen;
  both columns scroll in case a bigger font setting pushes them past it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_spire"
    android:padding="20dp">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="5"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingEnd="20dp">

            <!-- The title in the game's colours: gold words, a teal numeral. Plain type, not the logo. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:shadowColor="@color/title_shadow"
                    android:shadowDx="2"
                    android:shadowDy="3"
                    android:shadowRadius="2"
                    android:text="@string/launcher_title_words"
                    android:textColor="@color/title_gold"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="serif"
                    android:shadowColor="#CC0B2A30"
                    android:shadowDx="2"
                    android:shadowDy="3"
                    android:shadowRadius="2"
                    android:text="@string/launcher_title_numeral"
                    android:textColor="@color/teal"
                    android:textSize="40sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="serif"
                android:shadowColor="#E6000000"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="@string/launcher_subtitle"
                android:textColor="@color/teal"
                android:textSize="13sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/txt_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="center"
                android:minLines="2"
                android:shadowColor="#E6000000"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="@string/launcher_status_idle"
                android:textColor="@color/menu_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_primary"
                style="@style/LauncherMenuItem.Primary"
                android:focusedByDefault="true"
                android:text="@string/action_launch" />

            <ProgressBar
                android:id="@+id/progress_download"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:max="1000"
                android:progressBackgroundTint="@color/spire_shade"
                android:progressTint="@color/menu_selected"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_update"
                style="@style/LauncherMenuItem"
                android:layout_marginTop="4dp"
                android:text="@string/action_update" />

            <Button
                android:id="@+id/btn_settings"
                style="@style/LauncherMenuItem"
                android:text="@string/action_settings" />

            <Button
                android:id="@+id/btn_logs"
                style="@style/LauncherMenuItem"
                android:text="@string/action_logs" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4"
        android:background="@drawable/bg_card"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <include
                android:id="@+id/step_account"
                layout="@layout/item_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/step_game"
                layout="@layout/item_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/step_play"
                layout="@layout/item_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:text="@string/cloud_title"
                    android:textAllCaps="true"
                    android:textColor="@color/menu_selected"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/spin_cloud"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/gold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_cloud_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_sync"
                    style="@style/LauncherMenuItem.Small"
                    android:layout_weight="2"
                    android:text="@string/action_sync_now" />

                <Button
                    android:id="@+id/btn_pull"
                    style="@style/LauncherMenuItem.Small"
                    android:layout_weight="1"
                    android:contentDescription="@string/action_pull_saves"
                    android:text="@string/action_pull_short" />

                <Button
                    android:id="@+id/btn_push"
                    style="@style/LauncherMenuItem.Small"
                    android:layout_weight="1"
                    android:contentDescription="@string/action_push_saves"
                    android:text="@string/action_push_short" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txt_log_tail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:ellipsize="end"
                android:focusable="true"
                android:clickable="true"
                android:fontFamily="monospace"
                android:foreground="@drawable/focus_on_dark"
                android:maxLines="1"
                android:padding="4dp"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
